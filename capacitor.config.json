{
  "appId": "com.roomcraft.ar",
  "appName": "RoomCraft AR",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
